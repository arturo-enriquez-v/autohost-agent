# Local lab settings for `make lab-*` / `make node-*` (scripts/lab.sh).
# Copy to lab.env (gitignored) and adjust. Variables set on the command line win over this file.

# ── Incus test servers ──
# NAME=autohost-test            # default instance for lab-create / lab-deploy / lab-enroll / lab-link
# RAM=512MiB
# CPU=1
# IMAGE=images:ubuntu/24.04

# ── Local stack ──
# CLOUD_URL=http://localhost:3000
# API_PORT=8080
# GRPC_PORT=9090
# DATABASE_URL=                 # defaults to the one in ../autohost-cloud-api/.env (used by node-setup)
# ENROLL_USER_EMAIL=            # owner of node-setup enrollment tokens (default: first admin)

# ── Real node on the LAN (node-*) ──
NODE_HOST=user@192.168.1.50     # SSH target of the node
NODE_NAME=my-node               # name shown in the dashboard
HOST_IP=192.168.1.10            # this machine's address as seen from the node
